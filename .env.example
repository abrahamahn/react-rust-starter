# Development-only defaults. Copy to .env; never commit a real environment file.
APP_MODE=development
APP_BIND=127.0.0.1:8088
APP_ORIGIN=http://127.0.0.1:5178
APP_DATABASE_URL=postgresql://starter:local-development-only@127.0.0.1:55432/starter_dev?sslmode=disable
SMTP_HOST=127.0.0.1
SMTP_PORT=1025
MAIL_FROM="Starter <noreply@example.test>"
# SMTP_USERNAME and SMTP_PASSWORD are required only for production SMTP.
