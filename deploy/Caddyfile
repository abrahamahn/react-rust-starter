# Manual single-host production template. Set APP_DOMAIN and PWA_ROOT explicitly.
# Rust stays on loopback. This file never starts/deploys a service by itself.
{$APP_DOMAIN} {
    encode zstd gzip
    header {
        X-Content-Type-Options nosniff
        Referrer-Policy no-referrer
        X-Frame-Options DENY
        Permissions-Policy "camera=(), microphone=(), geolocation=()"
        Strict-Transport-Security "max-age=31536000"
        Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self'; font-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'; form-action 'self'"
    }
    handle /api/* {
        reverse_proxy 127.0.0.1:8088
    }
    handle {
        root * {$PWA_ROOT}
        @fresh path / /index.html /sw.js /manifest.webmanifest /offline.html
        header @fresh Cache-Control "no-cache"
        @bundles path /assets/*
        header @bundles Cache-Control "public, max-age=31536000, immutable"
        try_files {path} /index.html
        file_server
    }
}
